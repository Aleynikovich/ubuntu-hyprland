diff --git a/client/displayservers/Wayland/input.c b/client/displayservers/Wayland/input.c
index 52d7243..949df37 100644
--- a/client/displayservers/Wayland/input.c
+++ b/client/displayservers/Wayland/input.c
@@ -91,12 +91,30 @@ static void pointerAxisHandler(void * data, struct wl_pointer * pointer,
   if (axis != WL_POINTER_AXIS_VERTICAL_SCROLL)
     return;
 
-  int button = value > 0 ?
-    5 /* SPICE_MOUSE_BUTTON_DOWN */ :
-    4 /* SPICE_MOUSE_BUTTON_UP */;
-  app_handleButtonPress(button);
-  app_handleButtonRelease(button);
-  app_handleWheelMotion(wl_fixed_to_double(value) / 15.0);
+  /* touchpads send many small events plus a zero-valued one when the scroll
+   * ends; sending a click for each (zero counting as "up") makes the page
+   * bounce at the end. Accumulate and send one click per 15 units. */
+  static double accum = 0;
+  double v = wl_fixed_to_double(value);
+  if (v == 0)
+  {
+    accum = 0;
+    return;
+  }
+  if ((v > 0) != (accum > 0))
+    accum = 0;
+  accum += v;
+
+  while (accum >= 15.0 || accum <= -15.0)
+  {
+    int button = accum > 0 ?
+      5 /* SPICE_MOUSE_BUTTON_DOWN */ :
+      4 /* SPICE_MOUSE_BUTTON_UP */;
+    app_handleButtonPress(button);
+    app_handleButtonRelease(button);
+    app_handleWheelMotion(accum > 0 ? 1.0 : -1.0);
+    accum -= accum > 0 ? 15.0 : -15.0;
+  }
 }
 
 static int mapWaylandToSpiceButton(uint32_t button)
