{
  "github.copilot.nextEditSuggestions.enabled": true,
  "explorer.confirmDragAndDrop": false,
  "debug.javascript.defaultRuntimeExecutable": {
    "pwa-node": "node"
  },
  "git.openRepositoryInParentFolders": "always",
  "git.autofetch": true,
  "git.confirmSync": false,
  "terminal.integrated.stickyScroll.enabled": false,
  "git.enableSmartCommit": true,
  "editor.stickyScroll.enabled": false,
  "files.associations": {
    "*.md": "markdown"
  },
  "[instructions]": {
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.unicodeHighlight.invisibleCharacters": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },
  "chat.agent.maxRequests": 300,
  "makefile.configureOnOpen": true,
  "files.autoSave": "off",
  "chat.agent.thinkingStyle": "expanded",
  "chat.agent.todoList": {
    "position": "default"
  },
  "chat.tools.global.autoApprove": false,
  "security.workspace.trust.untrustedFiles": "open",
  "explorer.confirmDelete": false,
  "editor.fontFamily": "JetBrainsMono Nerd Font, FiraCode Nerd Font, Droid Sans Mono, monospace",
  "editor.fontLigatures": false,
  "editor.mouseWheelZoom": true,
  "editor.allowVariableFonts": false,
  "editor.minimap.size": "fill",
  "editor.wordWrap": "on",
  "debug.onTaskErrors": "showErrors",
  "explorer.confirmPasteNative": false,
  "http.systemCertificatesNode": true,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "window.confirmSaveUntitledWorkspace": false,
  "latex-workshop.latex.recipe.default": "latexmk (xelatex)",
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk",
      "tools": [
        "latexmk"
      ]
    },
    {
      "name": "latexmk (latexmkrc)",
      "tools": [
        "latexmk_rconly"
      ]
    },
    {
      "name": "latexmk (lualatex)",
      "tools": [
        "lualatexmk"
      ]
    },
    {
      "name": "latexmk (xelatex)",
      "tools": [
        "xelatexmk"
      ]
    },
    {
      "name": "pdflatex -> bibtex -> pdflatex * 2",
      "tools": [
        "pdflatex",
        "bibtex",
        "pdflatex",
        "pdflatex"
      ]
    },
    {
      "name": "Compile Rnw files",
      "tools": [
        "rnw2tex",
        "latexmk"
      ]
    },
    {
      "name": "Compile Jnw files",
      "tools": [
        "jnw2tex",
        "latexmk"
      ]
    },
    {
      "name": "Compile Pnw files",
      "tools": [
        "pnw2tex",
        "latexmk"
      ]
    },
    {
      "name": "tectonic",
      "tools": [
        "tectonic"
      ]
    }
  ],
  "latex-workshop.message.error.show": false,
  "latex-workshop.message.warning.show": false,
  "latex-workshop.latex.autoBuild.run": "onSave",
  "redhat.telemetry.enabled": false,
  "latex-workshop.latex.autoClean.run": "onBuilt",
  "editor.formatOnSave": true,
  "githubPullRequests.createOnPublishBranch": "never",
  "material-code.primaryColor": "#1A1C21",
  "chat.viewSessions.orientation": "stacked",
  "claudeCode.hideOnboarding": true,
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
    "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.ui": "default",
    "*.qrc": "qt-core.qrcEditor",
    "*.md": "vscode.markdown.preview.editor",
    "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.md": "default"
  },
  "claudeCode.preferredLocation": "panel",
  "gitlens.ai.enabled": false,
  "gitlens.graph.details.location": "auto",
  "claudeCode.useTerminal": true,
  "qt-core.showWelcomePageOnActivation": false,
  "security.promptForLocalFileProtocolHandling": false,
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],
  "remote.autoForwardPortsSource": "hybrid",
  "githubPullRequests.pullBranch": "never",
  "workbench.startupEditor": "none",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "task.allowAutomaticTasks": "on"
}
