#!/usr/bin/env python3
"""Keep end-4's generated colors in sync with WE Manager's selected preview."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import time

HOME = Path.home()
CONFIG = Path(os.environ.get('XDG_CONFIG_HOME', HOME / '.config'))
STATE = Path(os.environ.get('XDG_STATE_HOME', HOME / '.local/state'))
SCRIPTS = CONFIG / 'quickshell/ii/scripts/colors'
GENERATED = STATE / 'quickshell/user/generated'


def read_json(path):
    return json.loads(path.read_text())


def selected_preview():
    manager = CONFIG / 'we-manager'
    assignments = read_json(manager / 'config.json').get('assignments', {})
    if not assignments:
        return None
    # end-4 has one global palette: prefer the shared assignment, else the first screen.
    selected = assignments.get('*') or next(iter(assignments.values()))
    item = read_json(manager / 'library.json')['wallpapers'][selected]
    preview = Path(item.get('previewLocal') or '')
    if not preview.is_file():
        project = Path(item['localPath'])
        preview = project / read_json(project / 'project.json').get('preview', 'preview.jpg')
    if not preview.is_file():
        return None
    config = read_json(CONFIG / 'illogical-impulse/config.json')
    signature = (str(preview), preview.stat().st_mtime_ns,
                 json.dumps(config.get('appearance', {}), sort_keys=True))
    return preview, config, signature


def apply(preview, config):
    appearance = config.get('appearance', {})
    theming = appearance.get('wallpaperTheming', {})
    props = theming.get('terminalGenerationProps', {})
    scheme = appearance.get('palette', {}).get('type', 'auto')
    python = STATE / 'quickshell/.venv/bin/python'
    if scheme == 'auto':
        result = subprocess.run([str(python), str(SCRIPTS / 'scheme_for_image.py'), str(preview)],
                                capture_output=True, text=True, check=True, timeout=30)
        scheme = result.stdout.strip()
        if not scheme.startswith('scheme-'):
            scheme = 'scheme-tonal-spot'
    mode_result = subprocess.run(['gsettings', 'get', 'org.gnome.desktop.interface', 'color-scheme'],
                                 capture_output=True, text=True, check=True, timeout=10)
    mode = 'light' if 'prefer-light' in mode_result.stdout else 'dark'
    GENERATED.mkdir(parents=True, exist_ok=True)
    if theming.get('enableAppsAndShell', True):
        subprocess.run([str(HOME / '.local/opt/hyprland/bin/matugen'),
                        '--source-color-index', '0', 'image', str(preview),
                        '--mode', mode, '--type', scheme], check=True, timeout=90)
    if theming.get('enableTerminal', True):
        command = [str(python), str(SCRIPTS / 'generate_colors_material.py'),
                   '--path', str(preview), '--mode', 'dark' if props.get('forceDarkMode', True) else mode,
                   '--scheme', scheme, '--termscheme', str(SCRIPTS / 'terminal/scheme-base.json'),
                   '--blend_bg_fg', '--cache', str(GENERATED / 'color.txt')]
        for key, default in [('harmony', 0.6), ('harmonize_threshold', 100), ('term_fg_boost', 0.35)]:
            config_key = {'harmonize_threshold': 'harmonizeThreshold', 'term_fg_boost': 'termFgBoost'}.get(key, key)
            command += ['--' + key, str(props.get(config_key, default))]
        result = subprocess.run(command, capture_output=True, check=True, timeout=90)
        target = GENERATED / 'material_colors.scss'
        temporary = target.with_suffix('.tmp')
        temporary.write_bytes(result.stdout)
        temporary.replace(target)
        subprocess.run(['bash', str(SCRIPTS / 'applycolor.sh')], check=True, timeout=30)
    print(f'Applied wallpaper colors from {preview}', flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--watch', action='store_true', help='follow changes in WE Manager')
    args = parser.parse_args()
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
    with (runtime / 'ii-wallpaper-colors.lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        last = None
        last_error = None
        while True:
            try:
                selection = selected_preview()
                if selection and selection[2] != last:
                    apply(selection[0], selection[1])
                    last = selection[2]
                last_error = None
            except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
                if str(error) != last_error:
                    print(f'Wallpaper color sync: {error}', file=sys.stderr, flush=True)
                    last_error = str(error)
                if not args.watch:
                    return 1
            if not args.watch:
                return 0
            time.sleep(3)


if __name__ == '__main__':
    sys.exit(main())
