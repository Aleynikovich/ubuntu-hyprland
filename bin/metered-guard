#!/usr/bin/env bash
# Follow NetworkManager's "metered" flag on the default-route connection (the sidebar's Metered toggle sets it) and cut background
# traffic while it is on, then undo that when it is off:
#   - Syncthing: every device paused / resumed through its local API
#   - Windows VM (win11): its virtual NICs are unplugged / replugged (domif-setlink). Nothing is shut down, so no work is lost; the
#     guest just sees "cable unplugged" (Windows Update and sync clients stop eating the hotspot).
# State for the shell (modules/common/models/quickToggles/MeteredToggle.qml) goes to $XDG_RUNTIME_DIR/metered-guard.state:
#   "metered" or "free", then the list of what was paused.
# Not covered (needs root): apt / unattended-upgrades / fwupd timers. The remote-desktop stream (remoter-viewer over Tailscale) cannot be
# paused safely either; the toggle warns about it instead.
# Rollback: systemctl --user disable --now metered-guard (stopping it runs `metered-guard resume`, which also undoes the pauses).
cfg="$HOME/.local/state/syncthing/config.xml"
api=http://127.0.0.1:8384
state="${XDG_RUNTIME_DIR:-/tmp}/metered-guard.state"
vm=win11
virsh_() { virsh -c qemu:///system "$@"; }

syncthing() {  # pause|resume
  local key ids id
  key=$(grep -o '<apikey>[^<]*' "$cfg" 2>/dev/null | cut -d'>' -f2); [ -n "$key" ] || return 1
  ids=$(curl -s -H "X-API-Key: $key" "$api/rest/config/devices" | grep -o '"deviceID": "[^"]*"' | cut -d'"' -f4); [ -n "$ids" ] || return 1
  for id in $ids; do curl -s -o /dev/null -X POST -H "X-API-Key: $key" "$api/rest/system/$1?device=$id"; done
}

vm_link() {  # up|down, only while the VM runs (a stopped VM gets its link state at the next start: see the loop)
  [ "$(virsh_ domstate "$vm" 2>/dev/null)" = running ] || return 1
  virsh_ domiflist "$vm" 2>/dev/null | awk 'NR>2 && $5 ~ /:/ {print $5}' | while read -r mac; do virsh_ domif-setlink "$vm" "$mac" "$1" >/dev/null 2>&1; done
}

apply() {  # metered|free
  local did=""
  if [ "$1" = metered ]; then
    syncthing pause && did="$did syncthing"
    vm_link down && did="$did vm"
    notify-send -a Shell "Metered connection" "Syncthing${did:+ and the Windows VM network} paused. Remote desktop and everything else still use data." 2>/dev/null
  else
    syncthing resume
    vm_link up
  fi
  printf '%s\n%s\n' "$1" "${did# }" > "$state"
}

[ "${1:-}" = resume ] && { apply free; exit; }

last=""
while sleep 5; do
  dev=$(ip route show default | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
  [ -n "$dev" ] || continue
  case "$(nmcli -g GENERAL.METERED dev show "$dev" 2>/dev/null)" in yes*) now=metered ;; *) now=free ;; esac
  # a VM started while metered has its link up again: re-assert (cheap, only when metered)
  if [ "$now" = metered ] && [ "$now" = "$last" ]; then vm_link down; continue; fi
  [ "$now" = "$last" ] && continue
  apply "$now" && { echo "$dev is $now"; last=$now; }
done
